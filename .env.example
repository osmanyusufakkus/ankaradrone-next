# Bu dosyayı `.env.local` olarak kopyalayın ve secret değerleri yalnızca orada doldurun.
# `.env.local` git'e gönderilmez; bu örnek dosyada gerçek API key bulunmamalıdır.

# --- İletişim formu (Resend) ---
# https://resend.com/api-keys adresinden alınır.
RESEND_API_KEY=

# Geliştirme/test sırasında Resend hesabının sahibi olan adrese gönderim yapar.
# Domain doğrulandıktan sonra production değeri:
# Ankara Drone Web <form@notify.ankara-drone.com>
CONTACT_FROM_EMAIL="Ankara Drone Test <onboarding@resend.dev>"

# Form mesajlarının düşeceği gelen kutusu.
CONTACT_TO_EMAIL=osmanyusufakkus@gmail.com

# --- Site adresi ---
# Sondaki eğik çizgi olmadan, protokol dahil. sitemap.xml, robots.txt, JSON-LD
# ve sosyal medya paylaşım görselleri bu adresten üretilir.
NEXT_PUBLIC_SITE_URL=https://ankara-drone.com
