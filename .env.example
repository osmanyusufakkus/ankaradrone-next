# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# `.env.local` git'e gönderilmez (.gitignore'da tanımlı).

# --- İletişim formu (Resend) ---
# https://resend.com/api-keys adresinden alınır. Ücretsiz katman: 3.000 mail/ay.
RESEND_API_KEY=

# Formun gönderildiği "kimden" adresi. DİKKAT: bu adresin alan adı Resend'de
# doğrulanmış olmalı (resend.com/domains → DNS'e SPF + DKIM kaydı eklenir),
# aksi halde mailler gönderilmez veya spam'e düşer.
CONTACT_FROM_EMAIL="AnkaraDrone Web <bildirim@ankaradrone.com>"

# Form mesajlarının düşeceği kutu. Boş bırakılırsa lib/site.ts içindeki
# CONTACT.email kullanılır.
CONTACT_TO_EMAIL=info@ankaradrone.com

# --- Site adresi ---
# Sondaki eğik çizgi olmadan, protokol dahil. sitemap.xml, robots.txt, JSON-LD
# ve sosyal medya paylaşım görselleri bu adresten üretilir.
NEXT_PUBLIC_SITE_URL=https://www.ankaradrone.com
